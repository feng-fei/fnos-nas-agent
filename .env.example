# fnos-nas-agent runtime environment.
#
# The FPK launcher (apps/fnos-nas-agent/cmd/main) sets HOST, PORT and
# AGENT_DATA_DIR itself. This file documents the values the server falls back
# to when it is started directly with `npm start`.

# Listen address. The default is 0.0.0.0 so a phone on the same LAN can reach
# the console. Keep the service on a trusted network: HTTP is unencrypted.
# Set HOST=127.0.0.1 to restrict the service to this machine only.
HOST=0.0.0.0

# Listen port. The server resolves PORT, then TRIM_SERVICE_PORT, then 18787.
PORT=18787

# Directory for persistent state (sessions, model provider store, task
# snapshots, audit log). The FPK launcher points this at the package variable
# directory; leave it unset to use the platform default location.
# AGENT_DATA_DIR=

# Global execution mode.
#   normal    - default. Read-only tools and confirmed destructive actions are
#               available according to the permission policy.
#   read-only - every mutating tool is denied regardless of confirmation.
#   halted    - kill switch. All tool execution is denied.
# AGENT_EXECUTION_MODE=normal

# Budget for a single agent task in milliseconds. A model request that never
# returns is aborted after this budget and the task is marked as timed out.
# The default is 300000 (5 minutes), the maximum is 3600000 (1 hour) and 0
# disables the timeout.
# AGENT_TASK_TIMEOUT_MS=300000

# Path to the official fnOS `trim-cli` binary. When unset, the Agent reports
# the CLI as unconfigured and CLI-backed tools stay unavailable.
# TRIM_CLI_PATH=

# Profile name used by the official CLI. Defaults to "home".
# TRIM_CLI_PROFILE=home
