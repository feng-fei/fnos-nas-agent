# fnos-nas-agent runtime environment.
#
# Every value below mirrors the real behaviour of
# apps/fnos-nas-agent/app/server.mjs. The server only reads process.env, it
# does not load this file by itself: either export the variables in the
# service environment, or start the agent with
#   node --env-file=.env apps/fnos-nas-agent/app/server.mjs
#
# The fnOS package launcher (apps/fnos-nas-agent/cmd/main) sets HOST=0.0.0.0,
# PORT=$APP_PORT and AGENT_DATA_DIR=$TRIM_PKGVAR itself, so on a packaged
# installation the HOST, PORT and AGENT_DATA_DIR lines here are overridden.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Listen address. The default is 0.0.0.0, so the service listens on every
# network interface and a phone on the same LAN can reach the console.
# Plain HTTP is unencrypted: keep the service on a trusted network, or put a
# TLS terminating reverse proxy in front of it and set AGENT_TRUST_PROXY=1
# (see docs/phase-139-reverse-proxy-deployment.md).
# Set HOST=127.0.0.1 to restrict the service to this machine only.
HOST=0.0.0.0

# Listen port. The server resolves PORT first, then TRIM_SERVICE_PORT, and
# falls back to 18787. The default is 18787.
PORT=18787

# Fallback port that the fnOS package launcher uses when PORT is not set.
# The launcher turns it into PORT for the server, so PORT still wins.
# TRIM_SERVICE_PORT=18787

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Directory for persistent state: sessions, the password record, the first-run
# setup code, the audit log, the model provider store, task snapshots and
# execution-mode.json.
# There is no platform default. When AGENT_DATA_DIR is unset the agent has no
# persistent directory at all: the audit log stays unavailable and the first-run
# setup cannot be completed ("App data directory is not configured").
# On fnOS the launcher points this at $TRIM_PKGVAR.
# AGENT_DATA_DIR=/var/apps/fnos-nas-agent/var

# ---------------------------------------------------------------------------
# Execution policy
# ---------------------------------------------------------------------------
# Global execution mode.
#   normal    - default. Read-only tools and confirmed destructive actions are
#               available according to the permission policy.
#   read-only - every mutating tool is denied regardless of confirmation.
#   halted    - kill switch. All tool execution is denied.
# The state file <AGENT_DATA_DIR>/execution-mode.json wins over this variable,
# so an operator can change the mode from the console at any time.
# AGENT_EXECUTION_MODE=normal

# Budget for a single agent task in milliseconds. A model request that never
# returns is aborted after this budget and the task is marked as timed out.
# The default is 300000 (5 minutes), the maximum is 3600000 (1 hour) and 0
# disables the timeout. An invalid value falls back to the default and is
# reported in the service log.
# AGENT_TASK_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Trust the forwarding headers of a reverse proxy. The default is 0, the
# headers are ignored.
# Set AGENT_TRUST_PROXY=1 only when the agent is reachable exclusively through
# a reverse proxy that you control, and the agent port itself is not exposed
# to untrusted clients. In that mode the server honours X-Forwarded-Proto and
# X-Forwarded-Host to decide the browser origin of the same-origin check and
# the Secure attribute of the session cookie. With the default 0 those headers
# are only honoured for a loopback peer, so a forged header cannot make the
# agent believe that a request came from your own https origin.
# AGENT_TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Official fnOS CLI
# ---------------------------------------------------------------------------
# Path to the official fnOS trim-cli binary. When unset, the agent reports the
# CLI as unconfigured and the CLI backed tools stay unavailable.
# TRIM_CLI_PATH=/usr/bin/trim-cli

# Profile name used by the official CLI. The default is home.
# TRIM_CLI_PROFILE=home

# ---------------------------------------------------------------------------
# First-run setup
# ---------------------------------------------------------------------------
# There is no access token variable. On the very first start, while no
# password is configured, the server prints a one-time setup code to the
# terminal or the service log:
#   fnos-nas-agent first-run setup code: <code>
# Read it from the log (on a packaged fnOS installation:
# $TRIM_PKGVAR/agent.log) and enter it in the browser. The code is stored in
# <AGENT_DATA_DIR>/setup-code.txt and removed as soon as the password is set.
# Every caller that is not on the appliance itself has to present it.
