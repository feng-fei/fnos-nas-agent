#!/bin/bash
set -eu

APP_PORT="${TRIM_SERVICE_PORT:-18787}"
APP_ROOT="${TRIM_APPDEST:-}"
APP_VAR="${TRIM_PKGVAR:-}"
APP_LOG="${TRIM_TEMP_LOGFILE:-/tmp/fnos-nas-agent-fpk.log}"
PID_FILE="${APP_VAR}/agent.pid"
NODE_BIN="${APP_ROOT}/bin/node"
ENTRY="${APP_ROOT}/server.mjs"

fail() {
  message="$1"
  printf '%s\n' "$message" > "$APP_LOG"
  exit 1
}
is_running() {
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null
}
case "${1:-}" in
  start)
    [ -n "$APP_ROOT" ] || fail "TRIM_APPDEST 未设置，无法定位应用文件。"
    [ -n "$APP_VAR" ] || fail "TRIM_PKGVAR 未设置，无法定位应用数据目录。"
    [ -x "$NODE_BIN" ] || fail "应用内置 Node.js 运行时缺失；此构建不能启动。"
    [ -f "$ENTRY" ] || fail "应用入口文件缺失。"
    mkdir -p "$APP_VAR"
    if is_running; then exit 0; fi
    rm -f "$PID_FILE"
    # LAN access is required for the web UI. Keep the app unprivileged;
    # do not expose this port to the public Internet.
    HOST=0.0.0.0 PORT="$APP_PORT" "$NODE_BIN" "$ENTRY" >> "$APP_VAR/agent.log" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$PID_FILE"
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then exit 0; fi
    rm -f "$PID_FILE"
    fail "Agent 启动失败，请检查应用日志。"
    ;;
  stop)
    if is_running; then
      pid="$(cat "$PID_FILE")"
      kill "$pid" 2>/dev/null || true
      i=0
      while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 10 ]; do
        sleep 1
        i=$((i + 1))
      done
      if kill -0 "$pid" 2>/dev/null; then kill -TERM "$pid" 2>/dev/null || true; fi
    fi
    rm -f "$PID_FILE"
    exit 0
    ;;
  status)
    if is_running; then exit 0; else exit 3; fi
    ;;
  *)
    echo "Usage: $0 {start|stop|status}" >&2
    exit 1
    ;;
esac
